# ═══════════════════════════════════════════
#  SOC-SIEM — Configuração de Segurança
#  Copie este arquivo para .env e preencha
# ═══════════════════════════════════════════

# Chave de API para o endpoint /api/ingest
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SIEM_API_KEY=TROQUE_POR_UMA_CHAVE_GERADA

# IP do seu VPS honeypot (deixe vazio para desabilitar o allowlist)
VPS_ALLOWED_IP=

# Limite de eventos por requisição no /api/ingest
INGEST_MAX_EVENTS_PER_REQUEST=500

# Porta do servidor Flask
SIEM_PORT=5000

# Define se o SIEM aceita conexões externas (0 = somente localhost)
SIEM_PUBLIC=0
